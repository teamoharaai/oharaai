EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Base URL for auth redirect links (email confirmation, OAuth). Set per
# environment (prod/preview/local). Falls back to window.location.origin on web
# when unset. No trailing slash.
EXPO_PUBLIC_SITE_URL=
ANTHROPIC_API_KEY=
# Server-only — never prefix with EXPO_PUBLIC_. Used by API routes that call
# get_or_create_general_folder() (service_role-only RPC, see migration 014).
SUPABASE_SERVICE_ROLE_KEY=
