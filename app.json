{
  "expo": {
    "name": "Ohara",
    "slug": "oharaai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ohararouter",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "web": {
      "bundler": "metro",
      "output": "server",
      "favicon": "./assets/brand/ohara-logo.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "unstable_useServerRendering": true
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Allow OHARA to show your Apple Calendar events alongside your scheduled Tasks, Milestones, and Goal deadlines."
        }
      ],
      [
        "expo-document-picker",
        {
          "iCloudContainerEnvironment": "Production"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": false,
          "microphonePermission": false,
          "photosPermission": "Allow OHARA to import a photo you choose as private Source reference material."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
