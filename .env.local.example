# Copy to .env.local only after `supabase start` prints the local credentials.
# Never copy credentials from a shared Supabase project into this file.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=<local-anon-key-from-supabase-status>
SUPABASE_SERVICE_ROLE_KEY=<local-service-role-key-from-supabase-status>
